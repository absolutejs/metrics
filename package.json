{
	"name": "@absolutejs/metrics",
	"version": "0.3.2",
	"description": "Prometheus / OpenMetrics exposure for the AbsoluteJS substrate. Standardizes every package's metrics() shape into MetricSample[] + a Prometheus text-format renderer + an Elysia metricsPlugin. Per-source collectors as subpaths: runtime, router, egress, queue, sync, secrets, rate-limit, audit, dispatch, errors, logs.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/absolutejs/metrics.git"
	},
	"homepage": "https://github.com/absolutejs/metrics",
	"bugs": {
		"url": "https://github.com/absolutejs/metrics/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"license": "BSL-1.1",
	"author": "Alex Kahn",
	"absolutejs": {
		"manifestContract": 2,
		"runtimePeers": {
			"elysia": {
				"artifactImports": [
					"elysia"
				],
				"buildExternals": [
					"elysia"
				],
				"optional": true,
				"range": ">=1.4.29 <2",
				"tested": "1.4.29"
			}
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/collectors/runtime.d.ts",
			"import": "./dist/collectors/runtime.js",
			"default": "./dist/collectors/runtime.js"
		},
		"./router": {
			"types": "./dist/collectors/router.d.ts",
			"import": "./dist/collectors/router.js",
			"default": "./dist/collectors/router.js"
		},
		"./egress": {
			"types": "./dist/collectors/egress.d.ts",
			"import": "./dist/collectors/egress.js",
			"default": "./dist/collectors/egress.js"
		},
		"./queue": {
			"types": "./dist/collectors/queue.d.ts",
			"import": "./dist/collectors/queue.js",
			"default": "./dist/collectors/queue.js"
		},
		"./sync": {
			"types": "./dist/collectors/sync.d.ts",
			"import": "./dist/collectors/sync.js",
			"default": "./dist/collectors/sync.js"
		},
		"./secrets": {
			"types": "./dist/collectors/secrets.d.ts",
			"import": "./dist/collectors/secrets.js",
			"default": "./dist/collectors/secrets.js"
		},
		"./rate-limit": {
			"types": "./dist/collectors/rateLimit.d.ts",
			"import": "./dist/collectors/rateLimit.js",
			"default": "./dist/collectors/rateLimit.js"
		},
		"./audit": {
			"types": "./dist/collectors/audit.d.ts",
			"import": "./dist/collectors/audit.js",
			"default": "./dist/collectors/audit.js"
		},
		"./dispatch": {
			"types": "./dist/collectors/dispatch.d.ts",
			"import": "./dist/collectors/dispatch.js",
			"default": "./dist/collectors/dispatch.js"
		},
		"./errors": {
			"types": "./dist/collectors/errors.d.ts",
			"import": "./dist/collectors/errors.js",
			"default": "./dist/collectors/errors.js"
		},
		"./handoff": {
			"types": "./dist/collectors/handoff.d.ts",
			"import": "./dist/collectors/handoff.js",
			"default": "./dist/collectors/handoff.js"
		},
		"./logs": {
			"types": "./dist/collectors/logs.d.ts",
			"import": "./dist/collectors/logs.js",
			"default": "./dist/collectors/logs.js"
		},
		"./manifest": {
			"types": "./dist/manifest.d.ts",
			"import": "./dist/manifest.js",
			"default": "./dist/manifest.js"
		},
		"./manifest.json": "./dist/manifest.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts src/collectors/runtime.ts src/collectors/router.ts src/collectors/egress.ts src/collectors/queue.ts src/collectors/sync.ts src/collectors/secrets.ts src/collectors/rateLimit.ts src/collectors/audit.ts src/collectors/dispatch.ts src/collectors/errors.ts src/collectors/handoff.ts src/collectors/logs.ts src/manifest.ts --outdir dist --root src --sourcemap --target=bun --external @absolutejs/handoff --external elysia && tsc --project tsconfig.build.json && absolute-manifest emit",
		"test": "bun test tests/",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"./**/*.{ts,json,md}\"",
		"check:package": "bun run typecheck && bun run build && bun run test",
		"release": "bun run format && bun run check:package && bun publish"
	},
	"keywords": [
		"absolutejs",
		"prometheus",
		"openmetrics",
		"observability",
		"metrics",
		"elysia"
	],
	"peerDependencies": {
		"elysia": ">=1.4.29 <2"
	},
	"peerDependenciesMeta": {
		"elysia": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"elysia": "1.4.29",
		"prettier": "^3.8.3",
		"typescript": "^5.9.0"
	},
	"dependencies": {
		"@absolutejs/handoff": "0.1.0",
		"@absolutejs/manifest": "^0.7.1",
		"@sinclair/typebox": "^0.34.0"
	}
}
